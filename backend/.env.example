NODE_ENV=development
PORT=5000

# MongoDB (use your Atlas connection string for production)
MONGODB_URI=mongodb://atlas-sql-676ed1a9380c3569731ba009-2zi69.a.query.mongodb.net/test?ssl=true&authSource=mini_case_tracker

JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Local file uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# Password reset (dev returns resetUrl in API response)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=60
